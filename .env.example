# 复制成 .env 再填。任何 OpenAI 兼容接口都行，改 LLM_BASE_URL 和 LLM_MODEL 即可。

# ---- 模型接口（选一组，把前面的 # 去掉）----
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 通义千问（阿里云百炼，OpenAI 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# 腾讯混元
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbos-latest
# Moonshot / Kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-32k
# Claude（Anthropic 的 OpenAI 兼容端点）
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-4-5
# 公司内部的模型网关：填网关的 base url 和模型名即可

LLM_API_KEY=sk-把你的key填这里

# 页面右上角"模型"下拉的三档，不填就都用 LLM_MODEL
# LLM_MODEL_QUICK=deepseek-chat
# LLM_MODEL_COMPLEX=deepseek-reasoner

# 单次最长输出；对白环节产出大，建议 ≥ 8192（看模型上限）
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7

# ---- 图片模型（可选，环节 3 直接生成立绘）----
# 走 OpenAI 兼容的 images/generations：硅基流动（Kolors / FLUX）、OpenAI（gpt-image-1 / dall-e-3）、智谱 CogView 等
# IMG_BASE_URL=https://api.siliconflow.cn/v1
# IMG_API_KEY=
# IMG_MODEL=Kwai-Kolors/Kolors
# IMG_SIZE=1024x1024

# ---- 安全 ----
# 访问口令：设了之后页面"设置"里要填同一个值，否则谁拿到地址都能用你的 key
APP_TOKEN=
# 前端和后端不同域名时（比如前端放 GitHub Pages），填前端的域名；同域部署保持 *
ALLOW_ORIGIN=*

PORT=8787
