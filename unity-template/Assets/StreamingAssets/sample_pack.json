d": "map_forest", "x": 33, "y": 20, "type": "chest", "ref": "it_key"}, {"id": "e_c1", "map_id": "map_crypt", "x": 20, "y": 12, "type": "troop", "ref": "tr_bats"}, {"id": "e_c2", "map_id": "map_crypt", "x": 34, "y": 18, "type": "troop", "ref": "tr_boss"}, {"id": "e_c3", "map_id": "map_crypt", "x": 6, "y": 6, "type": "npc", "ref": "npc_ghost"}, {"id": "e_c4", "map_id": "map_crypt", "x": 30, "y": 6, "type": "chest", "ref": "it_sword"}], "tables/npcs.json": [{"id": "npc_mayor", "name": "林村长", "location": "loc_village", "function": "quest_giver", "personality": "说话慢，总是在担心雾。"}, {"id": "npc_smith", "name": "铁匠阿炳", "location": "loc_village", "function": "merchant", "personality": "嗓门大，心肠软。"}, {"id": "npc_girl", "name": "小满", "location": "loc_village", "function": "info", "personality": "好奇心重，偷偷去过森林。"}, {"id": "npc_hunter", "name": "猎人周", "location": "loc_forest", "function": "quest_giver", "personality": "沉默寡言，熟悉森林每一条路。"}, {"id": "npc_ghost", "name": "守墓人", "location": "loc_crypt", "function": "info", "personality": "没人知道他在这里待了多久。"}], "tables/troops.json": [{"id": "tr_wolves", "name": "狼群", "members": ["en_wolf", "en_wolf"]}, {"id": "tr_bats", "name": "蝙蝠群", "members": ["en_bat", "en_bat", "en_bat"]}, {"id": "tr_boss", "name": "墓穴守卫", "members": ["en_skel"]}], "tables/maps.json": [{"id": "map_village", "name": "雾港村", "type": "村庄", "size": "32x22", "connections": [{"to": "map_forest", "unlock": ""}]}, {"id": "map_forest", "name": "雾林", "type": "野外", "size": "40x26", "connections": [{"to": "map_village", "unlock": ""}, {"to": "map_crypt", "unlock": "q_02_done"}]}, {"id": "map_crypt", "name": "古墓", "type": "地牢", "size": "40x26", "connections": [{"to": "map_forest", "unlock": ""}]}], "tables/hero.json": [{"name": "阿雾", "identity": "从外乡来的旅人"}], "dialogue/dialogs.json": [{"id": "d_q_01_accept", "quest_id": "q_01", "stage": "accept", "nodes": [{"node_id": "n1", "speaker": "林村长", "text": "你终于来了。这三天，雾一天比一天浓，夜里还能听见森林那边有狼嚎。", "options": [{"text": "雾是从哪儿来的？", "next": "n2", "effects": []}, {"text": "我去森林看看。", "next": "n3", "effects": [{"type": "accept_quest"}]}]}, {"node_id": "n2", "speaker": "林村长", "text": "老人们说，是古墓的门开了。可古墓在森林最深处，没人敢去。", "options": [{"text": "我去。", "next": "n3", "effects": [{"type": "accept_quest"}]}]}, {"node_id": "n3", "speaker": "林村长", "text": "往东出村就是雾林。找猎人周，他认得路。", "options": [{"text": "好。", "next": null, "effects": [{"type": "set_flag", "flag": "q_01_accepted", "value": true}]}]}]}, {"id": "d_q_02_accept", "quest_id": "q_02", "stage": "accept", "nodes": [{"node_id": "n1", "speaker": "猎人周", "text": "……村长让你来的？狼群就在前面的空地，绕不过去。", "options": [{"text": "我来对付它们。", "next": "n2", "effects": [{"type": "accept_quest"}]}, {"text": "有别的路吗？", "next": "n3", "effects": []}]}, {"node_id": "n2", "speaker": "猎人周", "text": "打完狼，往东南走，那里有个古墓入口。小心里面的东西。", "options": [{"text": "继续", "next": null, "effects": []}]}, {"node_id": "n3", "speaker": "猎人周", "text": "没有。雾里只有一条路是活的。", "options": [{"text": "那就打。", "next": "n2", "effects": [{"type": "accept_quest"}]}]}]}, {"id": "d_q_03_accept", "quest_id": "q_03", "stage": "accept", "nodes": [{"node_id": "n1", "speaker": "铁匠阿炳", "text": "喂！要去古墓？我年轻时掉了一把剑在里面，你要是看到，就归你了！", "options": [{"text": "一言为定。", "next": null, "effects": [{"type": "accept_quest"}]}]}]}], "title.json": "雾港（示例）"}